{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>gr4vy/renovate-config:javascript"],
  "additionalReviewers": ["luca-gr4vy"],
  "ignorePaths": [".github/**", ".vscode/**"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "labels": ["dependencies", "internal"],
      "automerge": false,
      "semanticCommitScope": "dev-deps"
    },
    {
      "groupName": "types",
      "matchPackageNames": ["/@types/"]
    },
    {
      "matchPackageNames": ["react-native-screens"],
      "allowedVersions": "<4.26.0",
      "description": "4.26.0+ use React.ComponentRef in codegen specs (src/fabric/**); RN 0.83.4's parser only accepts React.ElementRef, so codegen fails and pod install breaks. 4.25.2 is the newest safe release. Lift once RN is upgraded."
    }
  ]
}
